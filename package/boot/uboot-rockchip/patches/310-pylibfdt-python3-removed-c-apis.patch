From: dtc upstream backport
Subject: [PATCH] pylibfdt: Replace removed SWIG Python 2 compatibility macros

SWIG 4.5.0 dropped the Python 2 compatibility macros (PyInt_*, PyString_*)
from its runtime header pyhead.swg, so the wrappers generated from
libfdt.i_shipped no longer compile:

  libfdt_wrap.c: error: call to undeclared function 'PyInt_AsLong'
  libfdt_wrap.c: error: call to undeclared function 'PyString_FromString'

pylibfdt is Python 3 only, so just use the Python 3 functions directly.
The replacements are safe since the macros were already aliased to these
exact functions in SWIG's Python 3 code path.

Backport of dtc commit 5008d1d6a356
("pylibfdt: Replace removed SWIG Python 2 compatibility macros").

--- a/scripts/dtc/pylibfdt/libfdt.i_shipped
+++ b/scripts/dtc/pylibfdt/libfdt.i_shipped
@@ -1033,7 +1033,7 @@
 	PyObject *buff;
 
 	if ($1) {
-		resultobj = PyString_FromString(
+		resultobj = PyUnicode_FromString(
 			fdt_string(fdt1, fdt32_to_cpu($1->nameoff)));
 		buff = PyByteArray_FromStringAndSize(
 			(const char *)($1 + 1), fdt32_to_cpu($1->len));
@@ -1064,13 +1064,13 @@
         }
         $1 = PyBytes_AsString($input);
     %#else
-        $1 = PyString_AsString($input);   /* char *str */
+        $1 = PyBytes_AsString($input);   /* char *str */
     %#endif
 }
 
 /* typemaps used for fdt_next_node() */
 %typemap(in, numinputs=1) int *depth (int depth) {
-   depth = (int) PyInt_AsLong($input);
+   depth = (int) PyLong_AsLong($input);
    $1 = &depth;
 }
 
